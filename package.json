{
  "name": "strive-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db.mts migrate",
    "db:seed": "tsx scripts/db.mts seed",
    "db:reset": "tsx scripts/db.mts reset",
    "db:links": "tsx scripts/db.mts links",
    "db:setup": "tsx scripts/db.mts migrate && tsx scripts/db.mts seed",
    "sync:push": "tsx scripts/push-metricool.mts",
    "verify": "tsx --conditions=react-server scripts/verify.mts",
    "verify:http": "tsx scripts/verify-http.mts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:security": "tsx scripts/check-rls.mts",
    "db:checkurl": "tsx scripts/check-dburl.mts",
    "smoke:prod": "tsx scripts/smoke-prod.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "iconsax-reactjs": "^0.0.8",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}
